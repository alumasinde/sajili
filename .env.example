APP_NAME="Onboarding Platform"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Nairobi
APP_KEY=base64:GENERATE_WITH_php_bin_console_key_generate

# Tenant/shared application database.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=onboarding_tenants
DB_USERNAME=root
DB_PASSWORD=

# Platform/control-plane database.
PLATFORM_DB_CONNECTION=mysql
PLATFORM_DB_HOST=127.0.0.1
PLATFORM_DB_PORT=3306
PLATFORM_DB_DATABASE=onboarding_platform
PLATFORM_DB_USERNAME=root
PLATFORM_DB_PASSWORD=

SESSION_NAME=onboarding_session
SESSION_LIFETIME=120
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax

LOG_LEVEL=debug
