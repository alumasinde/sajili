#!/usr/bin/env php
<?php

declare(strict_types=1);

require dirname(__DIR__) . '/vendor/autoload.php';

use App\Core\Database\DatabaseManager;
use App\Core\Database\MigrationRunner;
use App\Core\Support\Env;
use App\Core\Tenancy\TenantContext;
use App\Modules\Organizations\Repositories\DomainRepository;
use App\Modules\Organizations\Repositories\OrganizationRepository;
use App\Modules\Organizations\Services\OrganizationService;
use App\Modules\Roles\Repositories\RoleRepository;
use App\Modules\Roles\Services\RoleService;
use App\Modules\Access\Repositories\PermissionRepository;
use App\Modules\Users\Repositories\UserRepository;
use App\Modules\Users\Services\UserService;
use App\Modules\Departments\Repositories\DepartmentRepository;
use App\Modules\Departments\Repositories\DepartmentHodRepository;
use App\Modules\Departments\Services\DepartmentHodService;
use App\Modules\Departments\Services\DepartmentService;

Env::load(dirname(__DIR__));
date_default_timezone_set(Env::get('APP_TIMEZONE', 'Africa/Nairobi'));

$databases = new DatabaseManager();
$command = $argv[1] ?? 'help';

$options = [];
foreach (array_slice($argv, 2) as $argument) {
    if (str_starts_with($argument, '--') && str_contains($argument, '=')) {
        [$key, $value] = explode('=', substr($argument, 2), 2);
        $options[$key] = $value;
    }
}

try {
    $tenantContextFor = static function (int $organizationId) use ($databases): TenantContext {
        if ($organizationId < 1) {
            throw new InvalidArgumentException('--organization=ID is required.');
        }

        $platform = $databases->platform();
        $organization = (new OrganizationRepository($platform))->findById($organizationId);

        if ($organization === null) {
            throw new RuntimeException('Organization not found.');
        }

        $context = new TenantContext($databases);
        $context->set($organization);

        return $context;
    };

    switch ($command) {
        case 'migrate:platform':
            $platform = $databases->platform();
            $count = (new MigrationRunner($platform))->up(
                dirname(__DIR__) . '/database/migrations/platform',
                'platform_migrations'
            );
            echo "Platform migrations applied: {$count}" . PHP_EOL;
            break;

        case 'migrate:tenant':
            $id = (int) ($options['organization'] ?? 0);
            if ($id < 1) {
                throw new InvalidArgumentException('--organization=ID is required.');
            }

            $platform = $databases->platform();
            $repo = new OrganizationRepository($platform);
            $organization = $repo->findById($id);
            if ($organization === null) {
                throw new RuntimeException('Organization not found.');
            }

            $context = new TenantContext($databases);
            $context->set($organization);
            $count = (new MigrationRunner($context->connection()))->up(
                dirname(__DIR__) . '/database/migrations/tenant',
                'migrations'
            );
            $context->clear();

            echo "Tenant migrations applied: {$count}" . PHP_EOL;
            break;

        case 'org:create':
            $platform = $databases->platform();
            $service = new OrganizationService(
                $platform,
                new OrganizationRepository($platform),
                new DomainRepository($platform),
            );

            $id = $service->create([
                'name' => $options['name'] ?? '',
                'slug' => $options['slug'] ?? '',
                'domain' => $options['domain'] ?? '',
                'database_mode' => $options['database-mode'] ?? 'shared',
                'database_host' => $options['database-host'] ?? null,
                'database_port' => $options['database-port'] ?? 3306,
                'database_name' => $options['database-name'] ?? null,
                'database_username' => $options['database-username'] ?? null,
                'database_password' => $options['database-password'] ?? null,
            ]);

            echo "Organization created: {$id}" . PHP_EOL;
            break;

        case 'org:add-domain':
            $id = (int) ($options['organization'] ?? 0);
            $domain = strtolower(trim((string) ($options['domain'] ?? '')));
            if ($id < 1 || $domain === '') {
                throw new InvalidArgumentException('--organization=ID and --domain=HOST are required.');
            }

            $platform = $databases->platform();
            $repo = new OrganizationRepository($platform);
            if ($repo->findById($id) === null) {
                throw new RuntimeException('Organization not found.');
            }

            $domainRepo = new DomainRepository($platform);
            $domainRepo->create($id, $domain, false);
            echo "Domain added: {$domain}" . PHP_EOL;
            break;

        case 'key:generate':
            echo 'APP_KEY=base64:' . base64_encode(random_bytes(32)) . PHP_EOL;
            break;


        case 'roles:seed':
            $id = (int) ($options['organization'] ?? 0);
            $context = $tenantContextFor($id);

            (new RoleService(
                new RoleRepository($context),
                new PermissionRepository($context),
            ))->seedDefaults();

            $context->clear();
            echo "Default roles seeded for organization: {$id}" . PHP_EOL;
            break;

        case 'department:create':
            $id = (int) ($options['organization'] ?? 0);
            $context = $tenantContextFor($id);

            $departmentId = (new DepartmentService(
                new DepartmentRepository($context)
            ))->create([
                'name' => $options['name'] ?? '',
                'slug' => $options['slug'] ?? '',
            ]);

            $context->clear();
            echo "Department created: {$departmentId}" . PHP_EOL;
            break;

        case 'user:create':
            $id = (int) ($options['organization'] ?? 0);
            $context = $tenantContextFor($id);

            $userId = (new UserService(
                new UserRepository($context),
                new RoleRepository($context),
            ))->create([
                'first_name' => $options['first-name'] ?? '',
                'last_name' => $options['last-name'] ?? '',
                'email' => $options['email'] ?? '',
                'password' => $options['password'] ?? '',
                'department_id' => $options['department'] ?? null,
                'role' => $options['role'] ?? 'employee',
            ]);

            $context->clear();
            echo "User created: {$userId}" . PHP_EOL;
            break;

        case 'department:set-hod':
            $organizationId = (int) ($options['organization'] ?? 0);
            $departmentId = (int) ($options['department'] ?? 0);
            $userId = (int) ($options['user'] ?? 0);

            if ($departmentId < 1 || $userId < 1) {
                throw new InvalidArgumentException('--department=ID and --user=ID are required.');
            }

            $context = $tenantContextFor($organizationId);
            (new DepartmentHodService(
                new DepartmentRepository($context),
                new DepartmentHodRepository($context),
                new UserRepository($context),
                new RoleRepository($context),
            ))->assign($departmentId, $userId);
            $context->clear();

            echo "Department HOD assigned." . PHP_EOL;
            break;

        default:
            echo <<<TXT
Onboarding Platform console

Commands:
  migrate:platform
  migrate:tenant --organization=ID
  org:create --name="Glee Nairobi" --slug=glee-nairobi --domain=it.gleenairobi.co.ke --database-mode=shared
  org:create --name="Example" --slug=example --domain=it.example.com --database-mode=dedicated --database-host=127.0.0.1 --database-port=3306 --database-name=example_onboarding --database-username=user --database-password=secret
  org:add-domain --organization=ID --domain=hr.gleenairobi.co.ke
  roles:seed --organization=ID
  department:create --organization=ID --name="Information Technology" --slug=it
  user:create --organization=ID --first-name="Jane" --last-name="Wanjiku" --email="jane@example.com" --password="ChangeMe12345!" --role=it-admin --department=1
  department:set-hod --organization=ID --department=1 --user=1
  key:generate
TXT;
    }
} catch (Throwable $e) {
    fwrite(STDERR, 'ERROR: ' . $e->getMessage() . PHP_EOL);
    exit(1);
}
